{
  // 包名铁律：texturecraft 用专属 bundleName io.github.shaliuxin.texturecraft.hmos，
  // 其签名 profile（.p7b）绑定 bundleName + 设备 UDID，绝不复用 gridcraft/其它 craft 的产物。
  //
  // ⚠ 待重生（移植自 gridcraft 骨架，material 仍是 gridcraft 包名的 DevEco 材料，绑定旧 bundleName，
  // 直接打包会因 bundleName 与 profile 不匹配而失败 / 报 9568263 版本降级）：
  //   请在 DevEco Studio「File → Project Structure → Signing Configs」勾选自动签名，
  //   用 bundleName io.github.shaliuxin.texturecraft.hmos 重新签发绑定本机 UDID 的调试 profile，
  //   DevEco 会把它回写到本文件的 material 四件套（certpath/profile/storeFile + 口令 hex）。
  //   或纯命令行自测：bash scripts/make_texturecraft_signing.sh 生成 signing/ 下本地 CA 链
  //   （issuer=pki_internal，仅验证打包链路，真机安装报 9568257）——注意其 bundle-name 已是 texturecraft。
  // hvigor DecipherUtil 用 storeFile 同级目录的 material/ 解密，不是 ~/.ohos/config/material。
  "app": {
    // 占位符版本（公开仓库用）：真实签名材料不入库。
    // 本机真实配置另存为 signing/build-profile.local.json5（signing/ 已被 .gitignore 屏蔽），
    // scripts/run_on_device.sh 在打包前会自动还原成本地真实配置。
    // 首次使用请在 DevEco Studio「File → Project Structure → Signing Configs」勾选自动签名，
    // 用 bundleName io.github.shaliuxin.texturecraft.hmos 生成绑定本机 UDID 的调试 Profile。
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ],
    "capabilities": [
      {
        "bundleName": "io.github.shaliuxin.texturecraft.hmos",
        "config": []
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
